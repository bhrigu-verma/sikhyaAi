# ─────────────────────────────────────────────────────────────────────────
# Sikhya — environment variables. Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL — local or hosted, e.g. Supabase / Neon / Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/sikhya?schema=public"

# NextAuth — REQUIRED
NEXTAUTH_URL="http://localhost:3000"
# Generate with:   openssl rand -base64 32
NEXTAUTH_SECRET=""

# Encryption — REQUIRED for storing user API keys at rest.
# MUST be 64 hex characters = 32 bytes for AES-256-GCM.
# Generate with:   openssl rand -hex 32
ENCRYPTION_KEY=""

# ─── Email (Resend) ───
RESEND_API_KEY=""
EMAIL_FROM="Sikhya <onboarding@resend.dev>"

# ─── Cron + admin secrets ───
# Weekly parent digest cron auth (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
# One-off seed endpoint auth (POST /api/admin/seed with header x-seed-secret)
SEED_SECRET=""

# ─── Rate limiting (optional — Upstash Redis REST). ───
# If unset, an in-memory limiter is used (fine for dev / single instance,
# inaccurate across serverless instances). Get these from upstash.com.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Content moderation (optional) ───
# Used to call the OpenAI Moderation API for student-safety checks.
# Falls back to OPENAI_API_KEY if unset; local heuristics always run regardless.
OPENAI_MODERATION_KEY=""

# ─── Sikhya RAG backend (Hugging Face Space) ───
# The live backend URL — no key needed, it's open.
PYTHON_API_URL="https://bhriguverma-padhai-backend.hf.space"

# ─── AI Provider keys (optional fallbacks — users supply their own in /settings) ───
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GEMINI_API_KEY=""
GROQ_API_KEY=""
NVIDIA_API_KEY=""

# ─── OAuth (optional — set both to enable "Continue with Google") ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
